{
  "name": "twedel",
  "version": "0.13.3",
  "author": "ninjin",
  "license": "MIT",
  "homepage": "https://github.com/ninjin0802/twedel",
  "private": true,
  "type": "module",
  "description": "Windows desktop app for bulk-deleting your own tweets on X",
  "main": "desktop/main.cjs",
  "desktopName": "twedel.desktop",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "build": "npm run build:web && npm run build:server",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis -c.directories.output=release/win",
    "dist:win:ci": "npm run build && electron-builder --win nsis -c.directories.output=release/win --publish never",
    "release:win": "npm run build && electron-builder --win nsis -c.directories.output=release/win --publish always",
    "dist:linux": "npm run build && electron-builder --linux deb -c.directories.output=release/linux --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "concurrently": "^10.0.6",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "msw": "^2.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "jp.twedel.app",
    "productName": "twedel",
    "asar": true,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/.local-browsers/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "web/public/icon.png",
      "artifactName": "twedel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "deb",
      "icon": "web/public/icon.png",
      "category": "Utility",
      "maintainer": "ninjin",
      "artifactName": "twedel_${version}_${arch}.${ext}",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ninjin0802",
        "repo": "twedel"
      }
    ]
  }
}
